# ============================================================================
# Portfolio Monitoring Agent - Backend Environment Configuration (FastAPI)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. AI Reasoning Engines (at least ONE recommended for full agent synthesis)
# ----------------------------------------------------------------------------
# Google Gemini (Recommended for LangGraph StateGraph agent execution)
GOOGLE_API_KEY=your_google_api_key_here

# Groq (Alternative fallback model: Llama 3.1 8B Instant)
GROQ_API_KEY=your_groq_api_key_here

# ----------------------------------------------------------------------------
# 2. Authentication & Session Security
# ----------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (HS256)
# Generate a strong 32+ character key for production (e.g., openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters

# ----------------------------------------------------------------------------
# 3. Server, Network & CORS Configuration
# ----------------------------------------------------------------------------
# Port for FastAPI server (Render automatically sets PORT in production)
PORT=7860

# Allowed CORS Origins (comma-separated).
# The hosted Vercel URL and localhost:3000 are already built into the defaults.
CORS_ORIGINS=https://portfolio-monitoring-agent-six.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------------------------------------
# 4. Financial Data Providers (Optional - System defaults gracefully to yfinance & simulations)
# ----------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
MARKETAUX_API_KEY=your_marketaux_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
FRED_API_KEY=your_fred_api_key_here
HF_TOKEN=your_huggingface_token_here

# ----------------------------------------------------------------------------
# 5. Quantitative Risk & Anomaly Thresholds
# ----------------------------------------------------------------------------
# Z-score threshold for anomaly detection (default: 2.0 = ~95% confidence)
Z_THRESHOLD=2.0

# Portfolio weight drift tolerance before rebalance alert triggers (0.05 = 5%)
DRIFT_TOLERANCE=0.05

# EWMA lambda for volatility decay (0.94 is RiskMetrics standard)
EWMA_LAMBDA=0.94

# ----------------------------------------------------------------------------
# 6. Performance & Cache Settings
# ----------------------------------------------------------------------------
CACHE_TTL_SECONDS=900
