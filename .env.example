# ============================================================================
# Portfolio Monitoring Agent - Master Environment Variables Reference
# ============================================================================
# This repository is organized as a decoupled architecture:
# - Frontend: Next.js 14 App Router (Deployed on Vercel)
#   URL: https://portfolio-monitoring-agent-six.vercel.app/
# - Backend: FastAPI + LangGraph StateGraph (Deployed on Render)
#   URL: https://portfolio-monitoring-agent-main.onrender.com
# ============================================================================

# ============================================================================
# SECTION 1: FRONTEND ENVIRONMENT VARIABLES (Vercel / frontend/.env.local)
# ============================================================================

# The URL of the FastAPI backend service.
# For Vercel production deployment:
NEXT_PUBLIC_API_URL=https://portfolio-monitoring-agent-main.onrender.com

# For local development with frontend:
# NEXT_PUBLIC_API_URL=http://localhost:7860


# ============================================================================
# SECTION 2: BACKEND ENVIRONMENT VARIABLES (Render / backend/.env)
# ============================================================================

# 1. AI Reasoning Engines (at least ONE recommended)
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# 2. Authentication & Session Security (Recommended in production)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters

# 3. Server, Network & CORS Configuration
PORT=7860
CORS_ORIGINS=https://portfolio-monitoring-agent-six.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# 4. Financial Data Providers (Optional - built-in simulation and yfinance available)
TAVILY_API_KEY=your_tavily_api_key_here
MARKETAUX_API_KEY=your_marketaux_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
FRED_API_KEY=your_fred_api_key_here
HF_TOKEN=your_huggingface_token_here

# 5. Quantitative Risk & Anomaly Thresholds
Z_THRESHOLD=2.0
DRIFT_TOLERANCE=0.05
EWMA_LAMBDA=0.94

# 6. Performance & Cache Settings
CACHE_TTL_SECONDS=900
