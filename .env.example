# ============================================================================
# Portfolio Monitoring Agent - Master Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Frontend Configuration (Vercel / Next.js) -> set in frontend/.env.local or Vercel
# ----------------------------------------------------------------------------
# The frontend connects to the backend API. It does NOT hold direct third-party API keys.
NEXT_PUBLIC_API_URL=https://portfolio-monitoring-agent-main.onrender.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Supabase Public Credentials (client-side only)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# ----------------------------------------------------------------------------
# 2. Backend Configuration (Render / FastAPI) -> set in backend/.env or Render
# ----------------------------------------------------------------------------
# AI Reasoning Engines
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters

# Network & Server
PORT=7860
CORS_ORIGINS=https://portfolio-monitoring-agent-six.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Financial Data Providers
TAVILY_API_KEY=your_tavily_api_key_here
MARKETAUX_API_KEY=your_marketaux_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
FRED_API_KEY=your_fred_api_key_here
HF_TOKEN=your_huggingface_token_here

# Risk & Performance Thresholds
Z_THRESHOLD=2.0
DRIFT_TOLERANCE=0.05
EWMA_LAMBDA=0.94
CACHE_TTL_SECONDS=900
