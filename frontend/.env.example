# ============================================================================
# Portfolio Monitoring Agent - Frontend Environment Configuration (Next.js)
# ============================================================================

# Backend API Endpoint URL
# When deployed on Vercel, this points to your live Render backend:
NEXT_PUBLIC_API_URL=https://portfolio-monitoring-agent-main.onrender.com

# For local development with FastAPI running on localhost:
# NEXT_PUBLIC_API_URL=http://localhost:7860

# Optional Next.js Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Supabase Public Client Credentials (for client-side auth/state if configured)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
